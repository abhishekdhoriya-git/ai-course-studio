{
  "name": "ai-course-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first, approval-gated course production. Fixture media is explicitly non-cloned.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "start": "tsx src/server.ts",
    "fixture": "tsx src/cli.ts fixture",
    "render:fixture": "tsx src/cli.ts render-fixture",
    "skills:check": "tsx src/cli.ts skills-check",
    "test:ui": "playwright test",
    "doctor": "tsx src/cli.ts doctor"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.539",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.1": true
  }
}
